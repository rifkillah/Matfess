<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.matfess.app.ui.common.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_soft"
                    android:contentDescription="Kembali"
                    android:padding="11dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Sesi fokus"
                    android:textAppearance="@style/TextAppearance.Matfess.Headline" />

                <com.matfess.app.ui.common.LiquidButton
                    android:id="@+id/btnReset"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:text="Reset"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:lbRadius="19dp"
                    app:lbVariant="glass" />
            </LinearLayout>

            <com.matfess.app.ui.common.LiquidSegmented
                android:id="@+id/segMode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp" />

            <com.matfess.app.ui.common.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="24dp"
                app:gcPressEnabled="false"
                app:gcRadius="34dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="SESI FOKUS"
                        android:textAppearance="@style/TextAppearance.Matfess.Label" />

                    <com.matfess.app.ui.common.ProgressRingView
                        android:id="@+id/ring"
                        android:layout_width="258dp"
                        android:layout_height="258dp"
                        android:layout_marginTop="16dp"
                        app:prColorEnd="@color/accent_violet"
                        app:prColorStart="@color/accent_primary"
                        app:prProgress="1"
                        app:prShowText="true"
                        app:prStrokeWidth="14dp"
                        app:prSubText="MENIT : DETIK"
                        app:prSubTextSize="10sp"
                        app:prText="25:00"
                        app:prTextSize="52sp"
                        app:prTrackColor="@color/divider" />

                    <TextView
                        android:id="@+id/tvPhase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Tekan mulai, lalu jauhkan distraksi."
                        android:textAppearance="@style/TextAppearance.Matfess.Body" />

                    <com.matfess.app.ui.common.LiquidButton
                        android:id="@+id/btnStart"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="Mulai"
                        android:textSize="15sp"
                        app:lbRadius="28dp"
                        app:lbVariant="filled" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.matfess.app.ui.common.GlassCardView
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:padding="12dp"
                    app:gcPressEnabled="false"
                    app:gcRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSessionMinutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Matfess.Metric"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="menit sesi ini"
                            android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                    </LinearLayout>
                </com.matfess.app.ui.common.GlassCardView>

                <com.matfess.app.ui.common.GlassCardView
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:padding="12dp"
                    app:gcPressEnabled="false"
                    app:gcRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalSessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Matfess.Metric"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="sesi selesai"
                            android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                    </LinearLayout>
                </com.matfess.app.ui.common.GlassCardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Timer tetap berjalan saat aplikasi di latar belakang selama proses belum dimatikan."
                android:textAppearance="@style/TextAppearance.Matfess.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
