<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_soft"
                android:contentDescription="Kembali"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Random kelompok"
                android:textAppearance="@style/TextAppearance.Matfess.Headline" />
        </LinearLayout>

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="18dp"
            app:gcPressEnabled="false"
            app:gcRadius="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_soft">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shuffle"
                        app:tint="@color/accent_mint" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Bagi kelompok secara acak dan adil. Tempel daftar nama, pilih jumlah kelompok, lalu acak."
                    android:textAppearance="@style/TextAppearance.Matfess.Body" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Matfess.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Daftar nama (satu per baris)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapWords"
                android:minHeight="150dp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Jumlah kelompok"
            android:textAppearance="@style/TextAppearance.Matfess.Label" />

        <com.matfess.app.ui.common.LiquidSegmented
            android:id="@+id/segGroups"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="9dp" />

        <com.matfess.app.ui.common.LiquidButton
            android:id="@+id/btnShuffle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="Acak sekarang"
            app:lbVariant="filled" />

        <TextView
            android:id="@+id/tvResultSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="@style/TextAppearance.Matfess.Label" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center"
            android:padding="22dp"
            android:text="Hasil acakan muncul di sini. Nama tidak akan hilang atau terduplikasi."
            android:textAppearance="@style/TextAppearance.Matfess.Body" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/layout_group"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
