<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_soft"
                android:contentDescription="Kembali"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Kalkulator IPK"
                android:textAppearance="@style/TextAppearance.Matfess.Headline" />
        </LinearLayout>

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="22dp"
            app:gcPressEnabled="false"
            app:gcRadius="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IPK SIMULASI"
                        android:textAppearance="@style/TextAppearance.Matfess.Label" />

                    <TextView
                        android:id="@+id/tvIpk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.Matfess.Metric"
                        android:textSize="52sp" />

                    <TextView
                        android:id="@+id/tvPredikat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Body" />
                </LinearLayout>

                <com.matfess.app.ui.common.ProgressRingView
                    android:id="@+id/ringIpk"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    app:prColorEnd="@color/accent_mint"
                    app:prColorStart="@color/accent_primary"
                    app:prProgress="0"
                    app:prShowText="false"
                    app:prStrokeWidth="9dp"
                    app:prTrackColor="@color/divider" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalSks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge"
                android:padding="10dp"
                android:textAppearance="@style/TextAppearance.Matfess.Caption" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mata kuliah &amp; nilai"
                android:textAppearance="@style/TextAppearance.Matfess.Label" />

            <TextView
                android:id="@+id/btnAddRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="+ Tambah"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/courseContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.matfess.app.ui.common.LiquidButton
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Hitung IPK"
            app:lbVariant="filled" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_soft"
            android:padding="16dp"
            android:text="Bobot nilai: A = 4.0, A- = 3.7, B+ = 3.3, B = 3.0, B- = 2.7, C+ = 2.3, C = 2.0, D = 1.0, E = 0.0. Simulasi ini tidak mengubah data akademik kampus."
            android:textAppearance="@style/TextAppearance.Matfess.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
