<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="160dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Matfess.Headline"
                    android:textSize="18sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_soft"
                android:contentDescription="Pengaturan"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Matfess.Caption" />

        <com.matfess.app.ui.common.GlassCardView
            android:id="@+id/examCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            app:gcPressEnabled="false"
            app:gcRadius="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExamPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Label"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnEditExam"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circle_soft"
                        android:contentDescription="Atur tanggal ujian"
                        android:padding="8dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExamTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="-0.03"
                    android:textAppearance="@style/TextAppearance.Matfess.Title"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tvExamSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAppearance="@style/TextAppearance.Matfess.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Matfess.Number"
                            android:textSize="30sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HARI"
                            android:textAppearance="@style/TextAppearance.Matfess.Label"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Matfess.Number"
                            android:textSize="30sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JAM"
                            android:textAppearance="@style/TextAppearance.Matfess.Label"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMinutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Matfess.Number"
                            android:textSize="30sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MENIT"
                            android:textAppearance="@style/TextAppearance.Matfess.Label"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSeconds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Matfess.Number"
                            android:textSize="30sp"
                            android:textColor="@color/accent_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DETIK"
                            android:textAppearance="@style/TextAppearance.Matfess.Label"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/examProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:indicatorColor="@color/accent_primary"
                    app:trackColor="@color/divider"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExamTarget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />

                    <TextView
                        android:id="@+id/tvExamPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.matfess.app.ui.common.GlassCardView
                android:id="@+id/cardDayTracker"
                android:layout_width="0dp"
                android:layout_height="158dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                app:gcPressEnabled="true"
                app:gcRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.matfess.app.ui.common.ProgressRingView
                        android:id="@+id/ringSemester"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        app:prColorEnd="@color/accent_mint"
                        app:prColorStart="@color/accent_primary"
                        app:prProgress="0.4"
                        app:prShowText="false"
                        app:prStrokeWidth="8dp"
                        app:prTrackColor="@color/divider" />

                    <TextView
                        android:id="@+id/tvDayTracker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDayTrackerSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>

            <com.matfess.app.ui.common.GlassCardView
                android:id="@+id/cardFocus"
                android:layout_width="0dp"
                android:layout_height="158dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                app:gcPressEnabled="true"
                app:gcRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_soft"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_focus"
                        app:tint="@color/accent_amber" />

                    <TextView
                        android:id="@+id/tvFocusMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Metric"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="menit fokus"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />

                    <TextView
                        android:id="@+id/tvFocusSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption"
                        android:textColor="@color/accent_primary" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.matfess.app.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:padding="12dp"
                app:gcElevation="4dp"
                app:gcPressEnabled="false"
                app:gcRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatTasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tugas aktif"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>

            <com.matfess.app.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:padding="12dp"
                app:gcElevation="4dp"
                app:gcPressEnabled="false"
                app:gcRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Catatan"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>

            <com.matfess.app.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:padding="12dp"
                app:gcElevation="4dp"
                app:gcPressEnabled="false"
                app:gcRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatCerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sertifikat"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jadwal hari ini"
                android:textAppearance="@style/TextAppearance.Matfess.Label" />

            <TextView
                android:id="@+id/btnSeeSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Lihat semua"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmptySchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center"
            android:padding="18dp"
            android:text="Belum ada jadwal hari ini. Nikmati waktu luangmu."
            android:textAppearance="@style/TextAppearance.Matfess.Body"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tugas terdekat"
                android:textAppearance="@style/TextAppearance.Matfess.Label" />

            <TextView
                android:id="@+id/btnSeeTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Lihat semua"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmptyTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center"
            android:padding="18dp"
            android:text="Tidak ada deadline terdekat. Kamu aman untuk sekarang."
            android:textAppearance="@style/TextAppearance.Matfess.Body"
            android:visibility="gone" />

        <com.matfess.app.ui.common.GlassCardView
            android:id="@+id/quoteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="18dp"
            app:gcPressEnabled="false"
            app:gcRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/accent_violet" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Kutipan hari ini"
                        android:textAppearance="@style/TextAppearance.Matfess.Label" />

                    <ImageView
                        android:id="@+id/btnRefreshQuote"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_soft"
                        android:contentDescription="Ganti kutipan"
                        android:padding="8dp"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.Matfess.Body"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvQuoteAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            app:gcPressEnabled="false"
            app:gcRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_soft">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/accent_violet" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode tidur"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Senyapkan notifikasi saat dosen menjelaskan."
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>

                <com.matfess.app.ui.common.GlassSwitch
                    android:id="@+id/switchDnd"
                    android:layout_width="50dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    app:gsTint="@color/accent_violet" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pintasan"
            android:textAppearance="@style/TextAppearance.Matfess.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/quickNote"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_note"
                    app:tint="@color/accent_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Catatan"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickTask"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alarm"
                    app:tint="@color/accent_coral" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Tugas"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickSchedule"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/accent_sky" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Jadwal"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickRandom"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shuffle"
                    app:tint="@color/accent_mint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Random"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
