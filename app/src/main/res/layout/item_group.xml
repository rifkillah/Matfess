<?xml version="1.0" encoding="utf-8"?>
<com.matfess.app.ui.common.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    app:gcPressEnabled="false"
    app:gcRadius="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/badgeWrap"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_soft">

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Matfess.Headline"
                android:textColor="@color/text_on_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Matfess.Headline"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.Matfess.Body" />
        </LinearLayout>
    </LinearLayout>
</com.matfess.app.ui.common.GlassCardView>
