<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.matfess.app.ui.common.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="36dp">

        <FrameLayout
            android:id="@+id/logoWrap"
            android:layout_width="128dp"
            android:layout_height="128dp">

            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:background="@drawable/bg_circle_soft"
                android:alpha="0.55" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_mark" />
        </FrameLayout>

        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="-0.045"
            android:text="Matfess"
            android:textColor="@color/text_primary"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.Matfess.Body" />

        <com.matfess.app.ui.common.GlassCardView
            android:id="@+id/featureStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="11dp"
            app:gcElevation="4dp"
            app:gcPressEnabled="false"
            app:gcRadius="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Catatan  ·  Deadline  ·  Fokus"
                android:textAppearance="@style/TextAppearance.Matfess.Caption"
                android:textColor="@color/text_secondary" />
        </com.matfess.app.ui.common.GlassCardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="54dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circle_soft" />

            <View
                android:id="@+id/dot2"
                android:layout_width="22dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_primary_pill" />

            <View
                android:id="@+id/dot3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle_soft" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Menyiapkan ruang belajarmu"
            android:textAppearance="@style/TextAppearance.Matfess.Caption" />
    </LinearLayout>
</FrameLayout>
