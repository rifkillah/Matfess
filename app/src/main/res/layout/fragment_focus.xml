<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="160dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.03"
            android:text="Fokus"
            android:textAppearance="@style/TextAppearance.Matfess.Title"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Timer Pomodoro untuk belajar dengan ritme yang sehat."
            android:textAppearance="@style/TextAppearance.Matfess.Body" />

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="22dp"
            app:gcPressEnabled="false"
            app:gcRadius="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.matfess.app.ui.common.ProgressRingView
                    android:id="@+id/ring"
                    android:layout_width="188dp"
                    android:layout_height="188dp"
                    app:prColorEnd="@color/accent_violet"
                    app:prColorStart="@color/accent_primary"
                    app:prProgress="1"
                    app:prShowText="true"
                    app:prStrokeWidth="12dp"
                    app:prSubText="FOKUS"
                    app:prSubTextSize="10sp"
                    app:prText="25:00"
                    app:prTextSize="40sp"
                    app:prTrackColor="@color/divider" />

                <TextView
                    android:id="@+id/tvSessionInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption" />

                <com.matfess.app.ui.common.LiquidButton
                    android:id="@+id/btnStartSession"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Mulai sesi fokus"
                    app:lbVariant="filled" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.matfess.app.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:padding="14dp"
                app:gcPressEnabled="false"
                app:gcRadius="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Matfess.Metric"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="total menit fokus"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>

            <com.matfess.app.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:padding="14dp"
                app:gcPressEnabled="false"
                app:gcRadius="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Matfess.Metric"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sesi selesai"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>
            </com.matfess.app.ui.common.GlassCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pengaturan timer"
            android:textAppearance="@style/TextAppearance.Matfess.Label" />

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            app:gcPressEnabled="false"
            app:gcRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_soft">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_focus"
                        app:tint="@color/accent_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Durasi fokus"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvFocusDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditFocus"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle_soft"
                    android:contentDescription="Ubah durasi fokus"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            app:gcPressEnabled="false"
            app:gcRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_soft">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/accent_mint" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Durasi istirahat"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvBreakDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditBreak"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle_soft"
                    android:contentDescription="Ubah durasi istirahat"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <com.matfess.app.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            app:gcPressEnabled="false"
            app:gcRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_soft">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/accent_violet" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jangan Ganggu saat fokus"
                        android:textAppearance="@style/TextAppearance.Matfess.Headline"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Aktifkan mode prioritas selama timer berjalan."
                        android:textAppearance="@style/TextAppearance.Matfess.Caption" />
                </LinearLayout>

                <com.matfess.app.ui.common.GlassSwitch
                    android:id="@+id/switchDnd"
                    android:layout_width="50dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    app:gsTint="@color/accent_violet" />
            </LinearLayout>
        </com.matfess.app.ui.common.GlassCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_soft"
            android:padding="16dp"
            android:text="Tips: 25 menit fokus, 5 menit istirahat. Setelah 4 sesi, ambil istirahat lebih panjang. Kualitas istirahat menentukan kualitas fokus berikutnya."
            android:textAppearance="@style/TextAppearance.Matfess.Body" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
