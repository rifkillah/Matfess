<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="Kembali"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Menuju kelulusan"
            android:textAppearance="@style/TextAppearance.Matfess.Headline" />

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="Tambah item"
            android:padding="11dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/accent_primary" />
    </LinearLayout>

    <com.matfess.app.ui.common.LiquidSegmented
        android:id="@+id/segmented"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp" />

    <com.matfess.app.ui.common.GlassCardView
        android:id="@+id/progressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:padding="16dp"
        app:gcPressEnabled="false"
        app:gcRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.matfess.app.ui.common.ProgressRingView
                android:id="@+id/ringProgress"
                android:layout_width="84dp"
                android:layout_height="84dp"
                app:prColorEnd="@color/accent_mint"
                app:prColorStart="@color/accent_primary"
                app:prProgress="0"
                app:prShowText="true"
                app:prStrokeWidth="8dp"
                app:prSubText="SELESAI"
                app:prSubTextSize="8sp"
                app:prText="0%"
                app:prTextSize="20sp"
                app:prTrackColor="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProgressTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Matfess.Headline"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvProgressSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAppearance="@style/TextAppearance.Matfess.Caption" />
            </LinearLayout>
        </LinearLayout>
    </com.matfess.app.ui.common.GlassCardView>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/TextAppearance.Matfess.Caption" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGraduation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp"
            android:scrollbars="none" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRevisions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center"
            android:padding="26dp"
            android:textAppearance="@style/TextAppearance.Matfess.Body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
